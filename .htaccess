# ==========================================================================
# hika — root .htaccess
#
# Two jobs, in this order:
#   1. Keep the machinery (app/, the database file, the docs) off the web.
#   2. Give every page a short address: /about instead of /about.php, and
#      /projects/sifm instead of /project.php?slug=sifm.
#
# Rules run top to bottom and the first match wins, so the deny list has to
# sit above the "this file really exists, let it through" rule at the bottom.
# ==========================================================================

DirectoryIndex index.php
Options -Indexes

RewriteEngine On
RewriteBase /

# --------------------------------------------------------------------------
# 1. NEVER SERVED OVER HTTP
# --------------------------------------------------------------------------
# app/ holds config.php, which carries the database password, and the shared
# page parts. Every page `require`s them, and a require never passes through
# mod_rewrite, so denying the folder costs the site nothing.
RewriteRule ^app(?:/|$) - [F,L]
RewriteRule .*/includes/ - [F,L]

# Documentation and data files. composer/.env are named explicitly because
# they are the ones most likely to be typed into a browser by mistake.
RewriteRule \.(?:md|sql|log|ini|sh|bak|lock|swp|json)$ - [F,L]
RewriteRule ^composer\.(?:json|lock)$ - [F,L]
RewriteRule ^\.env$ - [F,L]
RewriteRule ^\.(?!well-known) - [F,L]

# --------------------------------------------------------------------------
# 2. THE ADMIN PANEL
# --------------------------------------------------------------------------
# /admin/projects opens admin/projects.php, and so on. The name is kept to
# lowercase words and dashes so a path can never climb out of admin/.
# The existence check matters under PHP-FPM: rewriting to a .php that is not
# there hands a missing file to the proxy, which answers with a bare "File not
# found." and skips ErrorDocument. Unmatched names now fall through to the 404.
RewriteRule ^admin/?$ admin/index.php [L]
RewriteCond %{DOCUMENT_ROOT}/admin/$1.php -f
RewriteRule ^admin/([a-z][a-z0-9-]*)/?$ admin/$1.php [L,QSA]

# --------------------------------------------------------------------------
# 3. PROJECT DETAIL PAGES
# --------------------------------------------------------------------------
# /projects/sifm -> project.php?slug=sifm. The slug is cut to letters, digits
# and dashes, so a path cannot smuggle in a slash or a dot.
RewriteRule ^projects/([A-Za-z0-9-]+)/?$ project.php?slug=$1 [L,QSA]

# --------------------------------------------------------------------------
# 4. THE SITEMAP
# --------------------------------------------------------------------------
# /sitemap.xml is generated from the rows the pages already read, so it can
# never list a project that has since been unpublished. It has to sit above
# the flat-page rule below, which does not match a name containing a dot.
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# --------------------------------------------------------------------------
# 5. SHORT ADDRESSES FOR THE FLAT PAGES
# --------------------------------------------------------------------------
# /about -> about.php, but only when nothing real lives at that name — so
# assets/css/style.css and the folders beneath it are left alone. $1 is tested
# rather than REQUEST_FILENAME so a trailing slash (/about/) still resolves.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-z][a-z0-9-]*)/?$ $1.php [L]

# --------------------------------------------------------------------------
# 6. POLITE ERRORS
# --------------------------------------------------------------------------
ErrorDocument 404 /404.php

# --------------------------------------------------------------------------
# 7. RESPONSE HEADERS
# --------------------------------------------------------------------------
# Four headers that cost nothing and close the usual browser-side holes: stop
# MIME sniffing, keep the full address out of other sites' logs, refuse to be
# framed, and switch off the browser features this site never asks for.
#
# A Content-Security-Policy is deliberately absent. The theme is chosen by a
# small inline script before the first paint, so a policy strict enough to be
# worth having would have to allow 'unsafe-inline' — which buys almost nothing.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
</IfModule>
